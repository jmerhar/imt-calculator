{
  "extends": "@jmerhar/frontend-config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // vite.config imports build-time SEO/registry helpers that reference app modules via @/ (the
    // guide registry, the DOM-free Lang type, engine types), so this project must resolve the alias.
    "paths": { "@/*": ["./src/*"] },
    "moduleDetection": "force",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts"]
}
