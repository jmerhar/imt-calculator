{
  "extends": "@jmerhar/frontend-config/tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
